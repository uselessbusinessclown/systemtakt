<style>
:root{
  --bg:#EEF1F4; --surface:#FFFFFF; --surface2:#F6F8FA; --ink:#101519; --ink2:#2C353E;
  --muted:#59636F; --line:#D5DCE3; --line2:#E7EDF2;
  --spr:#C31C26; --ice:#25648F; --ic:#96692A;
  --spr-bg:#FBE9EA; --ice-bg:#E5EFF6; --ic-bg:#F6EFE1;
  --ok:#2F7A52; --warn:#A8722A; --bad:#B0242E;
  --shadow:0 1px 2px rgba(16,21,25,.05),0 8px 24px -12px rgba(16,21,25,.16);
  --dial:#C9D2DA;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#0D1114; --surface:#151A1F; --surface2:#1B2229; --ink:#E7EDF2; --ink2:#C3CDD6;
    --muted:#8B98A5; --line:#242D35; --line2:#1E262D;
    --spr:#F0616A; --ice:#68AEDC; --ic:#D9A857;
    --spr-bg:#2A1518; --ice-bg:#12242F; --ic-bg:#2A2114;
    --ok:#5FBE8B; --warn:#D9A857; --bad:#F0616A;
    --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px -14px rgba(0,0,0,.7);
    --dial:#39444E;
  }
}
:root[data-theme="dark"]{
  --bg:#0D1114; --surface:#151A1F; --surface2:#1B2229; --ink:#E7EDF2; --ink2:#C3CDD6;
  --muted:#8B98A5; --line:#242D35; --line2:#1E262D;
  --spr:#F0616A; --ice:#68AEDC; --ic:#D9A857;
  --spr-bg:#2A1518; --ice-bg:#12242F; --ic-bg:#2A2114;
  --ok:#5FBE8B; --warn:#D9A857; --bad:#F0616A;
  --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px -14px rgba(0,0,0,.7);
  --dial:#39444E;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);
  font-family:"Barlow",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{font-family:"Barlow Condensed","Barlow",sans-serif;font-weight:700;
  letter-spacing:.005em;text-wrap:balance;margin:0}
.mono{font-family:"IBM Plex Mono",ui-monospace,monospace;font-variant-numeric:tabular-nums}
.wrap{max-width:1140px;margin:0 auto;padding:0 24px}
.eyebrow{font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.18em;
  text-transform:uppercase;color:var(--muted);margin:0 0 10px}

/* hero */
.hero{border-bottom:1px solid var(--line);background:
  radial-gradient(1100px 420px at 50% -14%, color-mix(in srgb,var(--ice) 9%, transparent), transparent 70%),
  var(--surface)}
.hero .wrap{padding-top:52px;padding-bottom:40px}
.hero h1{font-size:clamp(38px,6vw,68px);line-height:.98;margin-bottom:14px}
.hero .lede{font-size:clamp(16px,1.6vw,19px);color:var(--ink2);max-width:60ch;margin:0 0 6px}
.hero .meta{font-size:13px;color:var(--muted);margin-top:18px}
.herogrid{display:grid;grid-template-columns:1fr;gap:36px;align-items:center}
@media(min-width:900px){.herogrid{grid-template-columns:1.05fr .95fr;gap:44px}}

/* dial */
.dialbox{position:relative}
.dial{width:100%;height:auto;display:block;overflow:visible}
.dial .nd{cursor:pointer;transition:r .12s ease}
.dial .nd:hover{stroke-width:2.5}
.dial text{font-family:"IBM Plex Mono",monospace}
.chips{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-top:12px}
.chips .nchip{font-size:12.5px;padding:4px 10px;display:flex;gap:6px;align-items:baseline}
.chips .nchip b{font-weight:500;opacity:.7}
.dialcap{font-size:12.5px;color:var(--muted);text-align:center;margin-top:10px}
.nodecard{margin-top:14px;background:var(--surface2);border:1px solid var(--line);
  border-radius:4px;padding:14px 16px;min-height:112px}
.nodecard h4{font-size:20px;margin-bottom:2px}
.nodecard .kv{display:grid;grid-template-columns:repeat(auto-fit,minmax(96px,1fr));gap:10px 14px;margin-top:10px}
.nodecard .kv div span{display:block;font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.nodecard .kv div b{font-family:"IBM Plex Mono",monospace;font-weight:500;font-size:15px}

/* kpi */
.kpis{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);
  border:1px solid var(--line);border-radius:4px;overflow:hidden;margin:0}
@media(min-width:700px){.kpis{grid-template-columns:repeat(4,1fr)}}
.kpi{background:var(--surface);padding:16px 18px}
.kpi b{display:block;font-family:"Barlow Condensed",sans-serif;font-size:34px;line-height:1.05;font-weight:700}
.kpi span{font-size:12px;color:var(--muted)}

section{padding:56px 0}
section+section{border-top:1px solid var(--line)}
h2{font-size:clamp(26px,3.2vw,38px);margin-bottom:8px}
h3{font-size:21px;margin:28px 0 8px}
.sub{color:var(--muted);max-width:66ch;margin:0 0 22px}
p{max-width:70ch}

/* layer cards */
.layers{display:grid;grid-template-columns:1fr;gap:16px}
@media(min-width:820px){.layers{grid-template-columns:repeat(3,1fr)}}
.layer{background:var(--surface);border:1px solid var(--line);border-radius:4px;padding:18px 20px;
  border-top:3px solid var(--c)}
.layer .rank{font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.15em;color:var(--c);
  text-transform:uppercase}
.layer h3{margin:6px 0 6px;font-size:23px}
.layer p{font-size:14.5px;color:var(--ink2);margin:0 0 10px}
.layer ul{margin:0;padding-left:17px;font-size:14px;color:var(--muted)}
.layer li{margin-bottom:4px}
.layer .big{font-family:"IBM Plex Mono",monospace;font-size:15px;color:var(--ink);font-weight:500}

/* tables */
.tblwrap{overflow-x:auto;border:1px solid var(--line);border-radius:4px;background:var(--surface)}
table{border-collapse:collapse;width:100%;font-size:14px}
td.nw{white-space:nowrap}
#tl{min-width:760px}
#te{min-width:880px}
#tk{min-width:900px}
th{position:sticky;top:0;background:var(--surface);text-align:left;font-family:"Barlow Condensed",sans-serif;
  font-weight:600;font-size:13.5px;letter-spacing:.03em;text-transform:uppercase;color:var(--muted);
  padding:10px 12px;border-bottom:1px solid var(--line);white-space:nowrap;cursor:pointer;user-select:none}
th.no{cursor:default}
td{padding:8px 12px;border-bottom:1px solid var(--line2);vertical-align:middle}
tbody tr:last-child td{border-bottom:none}
tbody tr:hover{background:var(--surface2)}
td.n,th.n{text-align:right;font-family:"IBM Plex Mono",monospace;font-variant-numeric:tabular-nums;white-space:nowrap}
.scroll{max-height:520px;overflow-y:auto}
.controls{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:12px}
input[type=search]{font:inherit;font-size:14px;padding:7px 11px;border:1px solid var(--line);
  border-radius:3px;background:var(--surface);color:var(--ink);min-width:210px}
input[type=search]:focus-visible,button:focus-visible,th:focus-visible{outline:2px solid var(--ice);outline-offset:2px}
button.chip{font:inherit;font-size:13px;padding:6px 13px;border:1px solid var(--line);border-radius:100px;
  background:var(--surface);color:var(--muted);cursor:pointer}
button.chip[aria-pressed=true]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.tag{display:inline-block;font-family:"IBM Plex Mono",monospace;font-size:11px;padding:2px 7px;border-radius:3px;
  white-space:nowrap;font-weight:500}
.t-spr{background:var(--spr-bg);color:var(--spr)} .t-ice{background:var(--ice-bg);color:var(--ice)}
.t-ic{background:var(--ic-bg);color:var(--ic)}
.bar{display:block;height:7px;border-radius:2px;background:var(--line);position:relative;min-width:54px}
.bar i{position:absolute;left:0;top:0;bottom:0;border-radius:2px;background:var(--c)}
.dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--c);margin-right:6px;
  vertical-align:middle}

/* sprinter cards */
.sprgrid{display:grid;grid-template-columns:1fr;gap:14px}
@media(min-width:760px){.sprgrid{grid-template-columns:repeat(2,1fr)}}
.sprc{background:var(--surface);border:1px solid var(--line);border-left:3px solid var(--spr);
  border-radius:4px;padding:16px 18px;display:flex;gap:16px;align-items:flex-start}
.sprc .clock{flex:0 0 78px}
.sprc h4{font-size:19px;margin-bottom:2px}
.sprc .k{font-family:"IBM Plex Mono",monospace;font-size:11px;color:var(--spr);letter-spacing:.12em}
.sprc .row{display:flex;flex-wrap:wrap;gap:14px;margin-top:9px;font-size:13.5px}
.sprc .row div span{display:block;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.sprc .row div b{font-family:"IBM Plex Mono",monospace;font-weight:500;font-size:15px}
.sprc .note{font-size:13px;color:var(--muted);margin-top:8px}

/* distribution */
.dist{display:grid;gap:9px;margin:18px 0 8px;max-width:720px}
.dist .r{display:grid;grid-template-columns:150px 1fr 76px;gap:12px;align-items:center;font-size:14px}
@media(min-width:760px){.dist .r{grid-template-columns:236px 1fr 82px}}
.dist .r .b{height:20px;background:var(--line2);border-radius:2px;overflow:hidden}
.dist .r .b i{display:block;height:100%;background:var(--c)}
.dist .r .v{text-align:right;font-family:"IBM Plex Mono",monospace;font-size:13px;white-space:nowrap}

.vgrid{display:grid;grid-template-columns:1fr;gap:14px;margin:22px 0}
@media(min-width:860px){.vgrid{grid-template-columns:repeat(3,1fr)}}
.vc{background:var(--surface);border:1px solid var(--line);border-top:3px solid var(--c);border-radius:4px;padding:16px 18px}
.vc .rank{font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--c)}
.vc h4{font-size:20px;margin:5px 0 8px}
.vc p{font-size:14.5px;color:var(--ink2);margin:0}
/* scenario */
.scen{display:grid;grid-template-columns:1fr;gap:16px;margin-top:6px}
@media(min-width:760px){.scen{grid-template-columns:repeat(2,1fr)}}
.sc{background:var(--surface);border:1px solid var(--line);border-radius:4px;padding:18px 20px}
.sc h3{margin-top:0}
.sc .num{font-family:"Barlow Condensed",sans-serif;font-size:44px;font-weight:700;line-height:1;color:var(--c)}
.sc .num small{font-size:17px;color:var(--muted);font-weight:500}
.callout{background:var(--surface2);border:1px solid var(--line);border-left:3px solid var(--ice);
  border-radius:4px;padding:15px 18px;margin:22px 0;max-width:74ch}
.callout p{margin:0;font-size:14.5px;color:var(--ink2)}
.steps{display:grid;gap:14px;margin-top:8px}
.step{display:grid;grid-template-columns:56px 1fr;gap:16px;align-items:start}
.step .s{font-family:"Barlow Condensed",sans-serif;font-size:15px;font-weight:700;color:var(--surface);
  background:var(--ink);border-radius:3px;padding:5px 0;text-align:center}
.step p{margin:5px 0 0;font-size:14.5px;color:var(--ink2)}
.step h4{font-size:18px}
footer{border-top:1px solid var(--line);padding:30px 0 46px;color:var(--muted);font-size:13px}
footer a{color:var(--ice)}
.legend{display:flex;flex-wrap:wrap;gap:16px;font-size:13px;color:var(--muted);margin-top:12px}
</style>
